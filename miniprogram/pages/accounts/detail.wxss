.detail-page {
  padding-top: 24rpx;
}

.detail-hero {
  position: relative;
  margin-top: 16rpx;
  padding: 38rpx 36rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  border-radius: 42rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f7f9ff 100%);
  color: #111827;
  box-shadow: 0 28rpx 76rpx rgba(30, 41, 59, 0.10);
  overflow: hidden;
}

.detail-hero__top,
.detail-total,
.detail-metrics,
.detail-actions {
  position: relative;
  z-index: 1;
}

.detail-hero-weave {
  position: absolute;
  inset: 0;
  z-index: 0;
  opacity: 0.08;
  background:
    linear-gradient(90deg, rgba(99, 102, 241, 0.14) 1rpx, transparent 1rpx),
    linear-gradient(180deg, rgba(15, 23, 42, 0.10) 1rpx, transparent 1rpx);
  background-size: 46rpx 46rpx;
}

.detail-hero-sheen {
  position: absolute;
  top: -40rpx;
  left: 0;
  z-index: 0;
  width: 180rpx;
  height: 520rpx;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.15), rgba(255, 255, 255, 0));
  animation: sheen-slide 6s ease-in-out infinite;
}

.detail-hero__top,
.detail-actions,
.detail-metrics,
.holding-card,
.holding-meta,
.result-row {
  display: flex;
  align-items: center;
}

.detail-hero__top {
  justify-content: space-between;
  gap: 20rpx;
}

.detail-label,
.detail-name,
.detail-total,
.metric-label,
.metric-value,
.holding-symbol,
.holding-name,
.holding-value,
.result-symbol,
.result-name {
  display: block;
}

.detail-label {
  color: #64748b;
  font-size: 22rpx;
  font-weight: 620;
}

.detail-name {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 830;
}

.detail-total {
  margin-top: 34rpx;
  font-size: 70rpx;
  font-weight: 860;
  line-height: 1;
}

.detail-metrics {
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 28rpx;
  padding-top: 0;
  border-top: 0;
}

.detail-metrics > view {
  flex: 1;
  padding: 18rpx 16rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  border-radius: 20rpx;
  background: #f6f8fd;
}

.metric-label {
  color: #64748b;
  font-size: 20rpx;
  font-weight: 560;
}

.metric-value {
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 790;
}

.detail-actions {
  gap: 18rpx;
  margin-top: 28rpx;
  flex-wrap: wrap;
}

.action-pill {
  min-height: 58rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.12);
  border-radius: 999rpx;
  background: #f6f8fd;
  color: #334155;
  font-size: 24rpx;
  font-weight: 760;
  line-height: 58rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.12);
}

.action-pill--primary {
  border-color: rgba(104, 100, 255, 0.42);
  background: #6366f1;
  color: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(104, 100, 255, 0.24);
}

.action-pill--danger {
  border-color: rgba(210, 91, 78, 0.46);
  background: rgba(220, 38, 38, 0.08);
  color: #dc2626;
}

.holding-list {
  display: grid;
  gap: 16rpx;
}

.holding-card {
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 14rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  border-radius: 34rpx;
  background: #ffffff;
  box-shadow: 0 20rpx 56rpx rgba(30, 41, 59, 0.08);
}

.holding-main,
.holding-side {
  min-width: 0;
}

.holding-symbol {
  font-size: 31rpx;
  font-weight: 840;
  color: #111827;
}

.holding-name {
  margin-top: 6rpx;
  max-width: 390rpx;
  color: #64748b;
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.holding-side {
  text-align: right;
}

.holding-value {
  font-size: 30rpx;
  font-weight: 820;
}

.holding-day {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  font-weight: 700;
}

.holding-meta {
  justify-content: space-between;
  flex-basis: 100%;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(15, 23, 42, 0.08);
  color: #64748b;
  font-size: 23rpx;
}

.tx-panel {
  margin-bottom: 28rpx;
}

.tx-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  font-size: 28rpx;
  font-weight: 760;
}

.sheet {
  max-height: 86vh;
  padding: 34rpx 30rpx 48rpx;
  border-radius: 28rpx 28rpx 0 0;
  background: #ffffff;
  overflow-y: auto;
}

.sheet-title {
  margin-bottom: 22rpx;
  color: #111827;
  font-size: 34rpx;
  font-weight: 750;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  border-radius: 20rpx;
  background: #f1f4fb;
}

.search-input {
  flex: 1;
  height: 86rpx;
  color: #111827;
  font-size: 28rpx;
}

.search-hint {
  min-height: 34rpx;
  margin: 12rpx 4rpx;
  color: #64748b;
  font-size: 23rpx;
}

.result-list {
  display: grid;
  gap: 10rpx;
  max-height: 360rpx;
  overflow-y: auto;
}

.result-row {
  justify-content: space-between;
  gap: 18rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  border-radius: 20rpx;
  background: #f1f4fb;
}

.result-row--active {
  border-color: #6366f1;
  background: rgba(104, 100, 255, 0.16);
}

.result-symbol {
  font-size: 28rpx;
  font-weight: 730;
}

.result-name,
.result-market {
  color: #64748b;
  font-size: 23rpx;
}

.result-name {
  margin-top: 4rpx;
  max-width: 390rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  border-bottom: 1rpx solid rgba(15, 23, 42, 0.08);
  color: #111827;
  font-size: 28rpx;
}

.field-input {
  flex: 1;
  color: #111827;
  text-align: right;
}

.sheet-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 28rpx;
}
