.accounts-page {
  padding-top: 24rpx;
}

.top-actions {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  margin: 18rpx 4rpx 42rpx;
}

.round-action {
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  background: #ffffff;
  box-shadow: 0 18rpx 44rpx rgba(30, 41, 59, 0.08);
}

.round-action {
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  color: #5b5ce2;
  font-size: 58rpx;
  font-weight: 360;
  line-height: 78rpx;
  text-align: center;
}

.accounts-hero,
.account-list-card {
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  border-radius: 42rpx;
  background: #ffffff;
  box-shadow: 0 28rpx 76rpx rgba(30, 41, 59, 0.10);
}

.accounts-hero {
  position: relative;
  margin-bottom: 34rpx;
  padding: 34rpx 36rpx 40rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f7f9ff 100%);
  overflow: hidden;
}

.hero-watermark {
  position: absolute;
  right: 34rpx;
  bottom: 22rpx;
  width: 150rpx;
  height: 110rpx;
  opacity: 0.14;
  border-top: 24rpx solid #5b5ce2;
  border-right: 24rpx solid #5b5ce2;
  transform: skewX(-12deg);
}

.hero-kicker,
.hero-title,
.metric-label,
.metric-value,
.asset-name,
.asset-note,
.asset-amount,
.asset-currency {
  display: block;
}

.hero-kicker {
  color: #64748b;
  font-size: 25rpx;
  font-weight: 740;
}

.hero-title {
  margin-top: 20rpx;
  color: #111827;
  font-size: 70rpx;
  font-weight: 840;
  line-height: 1;
}

.hero-metrics {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  margin-top: 42rpx;
}

.metric-label {
  color: #64748b;
  font-size: 23rpx;
  font-weight: 650;
}

.metric-value {
  margin-top: 10rpx;
  font-size: 31rpx;
  font-weight: 820;
}

.account-list-card {
  padding: 30rpx 34rpx;
}

.list-head,
.list-title,
.asset-row {
  display: flex;
  align-items: center;
}

.list-head {
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.list-title {
  gap: 16rpx;
  color: #111827;
  font-size: 32rpx;
  font-weight: 850;
}

.market-arrow {
  color: #5b5ce2;
  font-size: 28rpx;
}

.market-count {
  min-width: 44rpx;
  height: 34rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.08);
  color: #64748b;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 34rpx;
  text-align: center;
}

.list-total {
  color: #111827;
  font-size: 28rpx;
  font-weight: 820;
}

.asset-row {
  gap: 26rpx;
  padding: 30rpx 0;
  border-top: 1rpx solid rgba(15, 23, 42, 0.08);
}

.asset-row:first-of-type {
  border-top: 0;
}

.asset-icon {
  position: relative;
  flex: 0 0 auto;
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  background: #6366f1;
}

.asset-icon::before {
  position: absolute;
  left: 17rpx;
  top: 20rpx;
  width: 28rpx;
  height: 20rpx;
  border: 4rpx solid #ffffff;
  border-radius: 6rpx;
  content: '';
}

.asset-copy {
  flex: 1;
  min-width: 0;
}

.asset-name {
  color: #111827;
  font-size: 30rpx;
  font-weight: 820;
}

.asset-note {
  margin-top: 6rpx;
  color: #7c8798;
  font-size: 23rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.asset-side {
  min-width: 210rpx;
  text-align: right;
}

.asset-amount {
  color: #111827;
  font-size: 31rpx;
  font-weight: 820;
}

.asset-currency {
  margin-top: 4rpx;
  color: #7c8798;
  font-size: 21rpx;
  font-weight: 720;
}

.choice-row,
.choice-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.choice-pill {
  min-width: 126rpx;
  height: 74rpx;
  padding: 0 24rpx;
  border-radius: 26rpx;
  background: #edf1f7;
  color: #64748b;
  font-size: 25rpx;
  font-weight: 760;
  line-height: 74rpx;
  text-align: center;
}

.choice-pill--active {
  background: #eef2ff;
  color: #4f46e5;
  box-shadow: inset 0 0 0 2rpx rgba(99, 102, 241, 0.26);
}

.stock-form {
  margin-top: 22rpx;
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx 28rpx;
}

.stock-field {
  min-width: 0;
}

.field-label {
  display: block;
  margin-bottom: 14rpx;
  color: #64748b;
  font-size: 24rpx;
  font-weight: 760;
}

.required {
  color: #ff6f7c;
}

.stock-input,
.readonly-pill,
.amount-outline {
  box-sizing: border-box;
  width: 100%;
  height: 78rpx;
  padding: 0 24rpx;
  border-radius: 28rpx;
  background: #edf1f7;
  color: #111827;
  font-size: 25rpx;
  font-weight: 760;
  line-height: 78rpx;
}

.readonly-pill {
  color: #a7a8ae;
}

.readonly-pill.muted {
  color: #7c8798;
}

.amount-outline {
  border: 2rpx solid rgba(15, 23, 42, 0.12);
  background: transparent;
  color: #5b5ce2;
}

.market-segment {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 6rpx;
  height: 78rpx;
  padding: 6rpx;
  border-radius: 30rpx;
  background: #edf1f7;
}

.market-option {
  border-radius: 24rpx;
  color: #64748b;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 66rpx;
  text-align: center;
}

.market-option--active {
  background: #ffffff;
  color: #4f46e5;
  box-shadow: 0 8rpx 22rpx rgba(99, 102, 241, 0.16);
}

.search-hint {
  display: block;
  min-height: 34rpx;
  margin-top: 22rpx;
  color: #7c8798;
  font-size: 22rpx;
  line-height: 1.45;
}

.result-list {
  margin-top: 16rpx;
  overflow: hidden;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  border-radius: 28rpx;
}

.result-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 22rpx;
  border-top: 1rpx solid rgba(15, 23, 42, 0.08);
}

.result-row:first-child {
  border-top: 0;
}

.result-row--active {
  background: rgba(104, 100, 255, 0.13);
}

.result-symbol,
.result-name,
.result-meta {
  display: block;
}

.result-symbol {
  color: #111827;
  font-size: 26rpx;
  font-weight: 840;
}

.result-name {
  max-width: 410rpx;
  margin-top: 5rpx;
  color: #7c8798;
  font-size: 21rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-meta {
  color: #5b5ce2;
  font-size: 22rpx;
  font-weight: 820;
}

.account-sheet {
  max-height: 86vh;
  padding: 26rpx 30rpx calc(env(safe-area-inset-bottom) + 34rpx);
  border-radius: 42rpx 42rpx 0 0;
  background: #f6f7fb;
  overflow-y: auto;
}

.sheet-head {
  display: grid;
  grid-template-columns: 96rpx 1fr 96rpx;
  align-items: center;
  margin-bottom: 24rpx;
}

.sheet-title {
  color: #111827;
  font-size: 34rpx;
  font-weight: 850;
  text-align: center;
}

.sheet-cancel,
.sheet-save {
  color: #64748b;
  font-size: 25rpx;
  font-weight: 760;
}

.sheet-save {
  color: #5b5ce2;
  text-align: right;
}

.sheet-name-card,
.sheet-card {
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  border-radius: 34rpx;
  background: #ffffff;
  box-shadow: 0 28rpx 76rpx rgba(30, 41, 59, 0.10);
}

.sheet-name-card {
  display: grid;
  grid-template-columns: 108rpx 1fr;
  align-items: center;
  gap: 24rpx;
  min-height: 150rpx;
  padding: 26rpx 30rpx;
  margin-bottom: 24rpx;
}

.sheet-account-icon {
  position: relative;
  width: 82rpx;
  height: 82rpx;
  border-radius: 50%;
  background: #6366f1;
}

.sheet-account-icon::before {
  position: absolute;
  left: 23rpx;
  top: 28rpx;
  width: 36rpx;
  height: 25rpx;
  border: 5rpx solid #ffffff;
  border-radius: 8rpx;
  content: '';
}

.sheet-name-input {
  height: 82rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: #eef2f8;
  color: #111827;
  font-size: 28rpx;
}

.sheet-card {
  padding: 30rpx;
}

.sheet-section-label {
  display: block;
  margin: 24rpx 0 18rpx;
  color: #64748b;
  font-size: 25rpx;
  font-weight: 760;
}

.sheet-section-label:first-child {
  margin-top: 0;
}

.sheet-field,
.sheet-toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  border-top: 1rpx solid rgba(15, 23, 42, 0.08);
  color: #111827;
  font-size: 28rpx;
}

.sheet-field {
  margin-top: 20rpx;
}

.sheet-field-input {
  flex: 1;
  color: #111827;
  text-align: right;
}

.sheet-toggle {
  position: relative;
  width: 86rpx;
  height: 50rpx;
  border-radius: 999rpx;
  background: #edf1f7;
}

.sheet-toggle-dot {
  position: absolute;
  left: 5rpx;
  top: 5rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #64748b;
  transition: left 160ms ease, background 160ms ease;
}

.sheet-toggle--on {
  background: #6366f1;
}

.sheet-toggle--on .sheet-toggle-dot {
  left: 41rpx;
  background: #ffffff;
}
