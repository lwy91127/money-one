.tab-safe {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  height: 0;
  padding: 0;
  pointer-events: none;
}

.tab-shell {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(constant(safe-area-inset-bottom) + 12rpx);
  bottom: calc(env(safe-area-inset-bottom) + 12rpx);
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  height: 112rpx;
  padding: 10rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 22rpx 60rpx rgba(30, 41, 59, 0.14);
  backdrop-filter: blur(20px);
  pointer-events: auto;
}

.tab-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-width: 0;
  border-radius: 26rpx;
  color: #64748b;
  transition: transform 150ms ease, background 150ms ease, color 150ms ease;
}

.tab-item--press {
  transform: scale(0.96);
}

.tab-item--active {
  color: #5b5ce2;
  background: #eef2ff;
  box-shadow: inset 0 0 0 1rpx rgba(99, 102, 241, 0.12);
}

.tab-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 16rpx;
  background: transparent;
}

.tab-item--active .tab-icon {
  background: rgba(99, 102, 241, 0.12);
}

.icon-shape,
.icon-shape::before,
.icon-shape::after {
  box-sizing: border-box;
}

.icon-shape {
  position: relative;
  display: block;
  color: currentColor;
}

.tab-icon--asset .icon-shape {
  width: 24rpx;
  height: 18rpx;
  border-left: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  border-radius: 2rpx;
}

.tab-icon--asset .icon-shape::before,
.tab-icon--asset .icon-shape::after {
  content: "";
  position: absolute;
  bottom: 2rpx;
  width: 4rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.tab-icon--asset .icon-shape::before {
  left: 7rpx;
  height: 12rpx;
}

.tab-icon--asset .icon-shape::after {
  left: 16rpx;
  height: 20rpx;
}

.tab-icon--account .icon-shape {
  width: 25rpx;
  height: 19rpx;
  border: 4rpx solid currentColor;
  border-radius: 6rpx;
}

.tab-icon--account .icon-shape::before {
  content: "";
  position: absolute;
  left: 4rpx;
  top: -8rpx;
  width: 13rpx;
  height: 8rpx;
  border: 4rpx solid currentColor;
  border-bottom: 0;
  border-radius: 6rpx 6rpx 0 0;
}

.tab-icon--account .icon-shape::after {
  content: "";
  position: absolute;
  right: 3rpx;
  top: 5rpx;
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: currentColor;
}

.tab-icon--transaction .icon-shape {
  width: 24rpx;
  height: 24rpx;
}

.tab-icon--transaction .icon-shape::before,
.tab-icon--transaction .icon-shape::after {
  content: "";
  position: absolute;
  left: 10rpx;
  top: 2rpx;
  width: 4rpx;
  height: 20rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.tab-icon--transaction .icon-shape::after {
  transform: rotate(90deg);
}

.tab-icon--settings .icon-shape {
  width: 24rpx;
  height: 24rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.tab-icon--settings .icon-shape::before {
  content: "";
  position: absolute;
  left: 6rpx;
  top: 6rpx;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: currentColor;
}

.tab-icon--settings .icon-shape::after {
  content: "";
  position: absolute;
  left: 8rpx;
  top: -8rpx;
  width: 4rpx;
  height: 36rpx;
  border-radius: 999rpx;
  background: currentColor;
  transform: rotate(45deg);
  opacity: 0.9;
}

.tab-label {
  font-size: 23rpx;
  font-weight: 760;
  line-height: 1;
}
