{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0",
    "types": ["miniprogram-api-typings", "node", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["miniprogram/*"]
    }
  },
  "include": ["miniprogram/**/*.ts", "tests/**/*.ts", "cloudfunctions/**/*.js", "vitest.config.ts"],
  "exclude": ["node_modules", "miniprogram/miniprogram_npm"]
}
